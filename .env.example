# CUBIQ Attendance Management System Configuration

# Application
NEXT_PUBLIC_APP_NAME="CUBIQ Attendance Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session Cookies (change this in production)
JWT_SECRET="cubic-attendance-secure-jwt-key-change-in-production-2026"

# ========================================================
# SQL DATABASE (Recommended for Vercel & Production)
# ========================================================
# Set either POSTGRES_URL or DATABASE_URL.
# If hosting on Vercel, simply connect a Vercel Postgres or Neon database in Vercel Storage.
# It automatically provides POSTGRES_URL!
POSTGRES_URL=""
DATABASE_URL=""

# ========================================================
# GOOGLE SHEETS DATABASE (Optional alternative)
# ========================================================
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# If neither POSTGRES_URL nor GOOGLE_SHEET_ID is set,
# the app immediately saves all records to a local persistent file on disk:
# data/cubic_database.json (data is never lost across restarts).
